{
  "name": "agy-sticky-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on-top desktop sticky monitor for active Google Antigravity conversations and live run durations.",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -n vite,main,app -c cyan,yellow,green \"vite --port 5173 --strictPort\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"node scripts/dev-runner.mjs\"",
    "build": "tsc -p tsconfig.main.json && tsc --noEmit && vite build",
    "launch": "electron .",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
